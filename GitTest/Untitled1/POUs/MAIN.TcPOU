<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="MAIN" Id="{5a8e1327-26d3-4e43-8559-97c135f86653}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	_fb : FB_ST10; 
	_test : BOOL;
	_promenliva : BOOL; 
	_ivana : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF _fb._robot() THEN 
	_test:= TRUE; 
	_promenliva:= FALSE; 
ELSE 
	_test:= FALSE; 
END_IF
_fb._tcpIp();
IF _fb._scanner() THEN 
	_promenliva:= TRUE; 
	_test:= FALSE; 
END_IF
_ivana:= 10; ]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
